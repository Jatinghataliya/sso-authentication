# ──────────────────────────────────────────────────────────────
# SSO Demo — Environment Variables Template
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────

# ── Auth0 (OIDC) ──────────────────────────────────────────────
# Dashboard: https://manage.auth0.com → Applications → your app
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
# Domain only — no https:// prefix, no trailing slash
# Example: my-testing-domain.us.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com

# ── GitHub (OAuth2) ───────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL:        http://localhost:8081
# Callback URL:        http://localhost:8081/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Google (OIDC) ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── App (optional — defaults shown) ───────────────────────────
APP_BASE_URL=http://localhost:8081
SERVER_PORT=8081
